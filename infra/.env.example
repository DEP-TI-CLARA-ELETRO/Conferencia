# Copie para infra/.env (docker compose) e para server/.env (API)

# Banco
DB_HOST=localhost
DB_PORT=5432
DB_NAME=conferencia
DB_USER=conferencia
DB_PASSWORD=conferencia_dev

# API
SERVER_PORT=8080
CORS_ORIGIN=*
SESSION_TTL_HOURS=12
MIGRATIONS_DIR=../infra/migrations

# Usuario admin criado pelo seed de desenvolvimento
SEED_ADMIN_EMAIL=admin@conferencia.local
SEED_ADMIN_PASSWORD=admin123

# Cria usuarios de exemplo (fiscal@ e tesouraria@conferencia.local) com a mesma senha do admin
SEED_DEMO_USERS=true

# WebPosto (postos GR) — cole a chave de integração; a API envia como ?chave=
# Obter em: WebPosto > Administração > Integrações > API Integração
WEBPOSTO_BASE_URL=https://web.qualityautomacao.com.br
WEBPOSTO_CHAVE=
