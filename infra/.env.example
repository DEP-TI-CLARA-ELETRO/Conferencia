# Copie para infra/.env e api/.env

MONGODB_URI=mongodb://127.0.0.1:27017/conferencia
MONGO_PORT=27017

# API
SERVER_PORT=8080
CORS_ORIGIN=*
SESSION_TTL_HOURS=12

# Usuario admin criado pelo seed de desenvolvimento
SEED_ADMIN_EMAIL=admin@conferencia.local
SEED_ADMIN_PASSWORD=admin123

# Cria usuarios de exemplo (fiscal@ e tesouraria@conferencia.local)
SEED_DEMO_USERS=true

# WebPosto (postos GR)
WEBPOSTO_BASE_URL=https://web.qualityautomacao.com.br
WEBPOSTO_CHAVE=

# Cupons de fechamento (foto/OCR)
# Os dois motores rodam juntos e cruzam valores (Vision tem prioridade; Tesseract completa).
COUPONS_UPLOAD_DIR=uploads/coupons
GOOGLE_VISION_API_KEY=
TESSERACT_BIN=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Programas\Conferencia\api\tessdata
